#!/bin/sh
# Pulseline pre-commit guardrail. Enable once per clone:  git config core.hooksPath .githooks
# Runs the same checks as CI (scripts/check.py); ESLint runs too once `npm install` is done.
cd "$(git rev-parse --show-toplevel)" || exit 1
if command -v python3 >/dev/null 2>&1; then PY=python3; else PY=python; fi
exec "$PY" scripts/check.py
